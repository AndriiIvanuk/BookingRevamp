
@{
    ViewData["Title"] = "Забув пароль";
    Layout = null;
}

@model BookingRevamp.Models.ViewModels.ForgotPasswordViewModel
<link rel="stylesheet" href="~/css/site.css" />

<!DOCTYPE html>
<html lang="uk">

<body>
    <div class="login-page">

        <div class="login-right">
            <div class="login-form-wrapper">
                <h1>Створи новий пароль</h1>
                <p class="subtitle">Введи свій email, щоб продовжити</p>

                <form class="register-form">
                    <div class="field">
                        <label>Email</label>
                        <input id="LoginEmailLink" type="Email" placeholder="Введи свій email" asp-for="Email">
                        <span asp-validation-for="Email" class="error-text"></span>
                    </div>
                    <div class="submit-btn">
                        <button class="btn btn-solid">Продовжити</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="login-left">
            <img src="" class="win-bg-word-right">
            <div class="register-box">
                <h2>Не маєш акаунту?</h2>
                <p>Зареєструйся, щоб зберігати та швидко бронювати</p>
                <a asp-controller="Authorize" asp-action="Register" class="btn btn-outline">Зареєструватися</a>
            </div>
        </div>

    </div>
    @section Scripts{<partial name="_ValidationScriptsPartial"/>}
</body>
</html>