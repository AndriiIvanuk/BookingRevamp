@{
    ViewData["Title"] = "Реєстрація";
}

<section class="register-page">
    <div class="register-left">
        <img src="" class="left-overlay-word"/>
        <div class="login-box">
            <h2>Вже маєш акаунт?</h2>
            <p>Увійди, щоб продовжити пошук ідеального житла</p>
            <a asp-controller="Home" asp-action="Login" class="btn btn-solid">Увійти</a>
        </div>
    </div>

    <div class="register-right">
        <div class="register-form-wrap">
            <h1>Зареєструй обліковий запис</h1>
            <p class="subtitle">Створи профіль, щоб зберігати та швидко бронювати</p>

            <form class="register-form">
                <div class="row two-cols">
                    <div class="field">
                        <label>Прізвище</label>
                        <input type="text" placeholder="Введи прізвище" />
                    </div>
                    <div class="field">
                        <label>Ім'я</label>
                        <input type="text" placeholder="Введи ім'я" />
                    </div>
                </div>

                <div class="field">
                    <label>По батькові</label>
                    <input type="text" placeholder="Введи своє по батькові" />
                </div>

                <div class="field">
                    <label>Email</label>
                    <input type="email" placeholder="Введи свій email" />
                </div>

                <div class="field">
                    <label>Номер телефону</label>
                    <input type="text" placeholder="Введи свій номер телефону" />
                </div>

                <div class="field password-field">
                    <label>Пароль</label>
                    <input type="password" placeholder="Придумай та запам’ятай пароль" />
                </div>

                <div class="field password-field">
                    <label>Підтвердити пароль</label>
                    <input type="password" placeholder="Введи придуманий пароль повторно" />
                </div>

                <label class="check-row">
                    <input type="checkbox" />
                    <span>Приймаю <a href="#">умови сервісу</a></span>
                </label>

                <button type="submit" class="btn register-btn">Зареєструватися</button>

                <p class="social-text">Створи акаунт або продовж через</p>
                <a href="#" class="btn google-btn">
                    <img src="~/Icons/Google.png" class="google-btn"/>
                </a>
            </form>
        </div>
    </div>
</section>