                        </div>

                        <span class="card-price">
                            від @property.PricePerNight@property.Currency за ніч
                        </span>

                    </div>

                </div>
            </a>}

        @for(int i = Model.Apartments.Count; i < 4; i++){
            <div class="card card-empty"></div>
        }

    </div>

    <div class="popular-head">
        <div>
            <h2>Розкішні віли Барселони</h2>
            <p>Віли поблизу моря та на схилах міста</p>
        </div>
