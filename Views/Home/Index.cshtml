@{
    ViewData["Title"] = "Home Page";
}
@model HomeViewModel

<link rel="stylesheet" href="~/css/site.css" />

<section class="hero-shell">
    <section class="hero">
        <img src="~/Icons/bg-word.svg" class="hero-bg-word"/>
        <div class="hero-content">
            <h1>Знайди найкраще місце для відпочинку</h1>
            <p>Швидко. Зручно. Разом із Winbook</p>
        </div>
        <div class="search-panel">
            <div class="search-row full">
                <img src="~/Icons/Home.png" class="icon"/>
                <input type="text" placeholder="Де хочете зупинитися?" />
            </div>
            <div class="search-bottom">
                <div class="search-row">
                    <img src="~/Icons/Calendar.png" class="icon"/>
                    <input type="text" placeholder="Дата заїзду" />
                </div>
                <div class="search-row">
                    <img src="~/Icons/Calendar.png" class="icon"/>
                    <input type="text" placeholder="Дата виїзду" />
                </div>
                <div class="search-row">
                    <img src="~/Icons/People.png" class="icon"/>
                    <input type="text" placeholder="Кого беремо з собою?" />
                    <button type="button" class="dropdown"><img src="/Icons/dropdown.png" /></button>
                </div>
                <button class="google-acid"><img src="~/Icons/Search.png" /></button>
            </div>
        </div>
    </section>
</section>
<section class="popular container">
    <div class="popular-head">
        <div>
            <h2>Популярні будинки Парижу</h2>
            <p>Приватні будинки з атмосферою класичного Парижу</p>
        </div>
        <button class="blue more-popular">Знайти більше помешкань</button>
    </div>

    <div class="cards">
        @foreach(var property in Model.Houses){
            <a asp-controller="Home" asp-action="Property" asp-route-id="@property.Id"class="card">

                @if(property.Images.Any()){
                    <img src="@property.Images.First().ImagePath" />
                }
                else{
                    <div class="card-image-placeholder"></div>
                }

                <div class="card-info">

                    <h3>@property.Object</h3>

                    <p>@property.City</p>

                    <div class="card-footer">

                        <div class="card-rating">
                            <img src="~/Icons/star.png" />
                            <img src="~/Icons/star.png" />
                            <img src="~/Icons/star.png" />
                            <img src="~/Icons/star.png" />
                            <img src="~/Icons/empty-star.png" />
                        </div>

                        <span class="card-price">
                            від @property.PricePerNight@property.Currency за ніч
                        </span>

                    </div>

                </div>
            </a>}

        @for(int i = Model.Houses.Count; i < 4; i++){
            <div class="card card-empty"></div>
        }

    </div>

    <div class="popular-head">
        <div>
            <h2>Найкращі готелі Амстердаму</h2>
            <p>Комфортні готелі біля каналів і в центрі міста</p>
        </div>
        <button class="blue more-popular">Знайти більше помешкань</button>
    </div>

    <div class="cards">
        @foreach(var property in Model.Hotels){
            <a asp-controller="Home" asp-action="Property" asp-route-id="@property.Id"class="card">

                @if(property.Images.Any()){
                    <img src="@property.Images.First().ImagePath" />
                }
                else{
                    <div class="card-image-placeholder"></div>
                }

                <div class="card-info">

                    <h3>@property.Object</h3>

                    <p>@property.City</p>

                    <div class="card-footer">

                        <div class="card-rating">
                            <img src="~/Icons/star.png" />
                            <img src="~/Icons/star.png" />
                            <img src="~/Icons/star.png" />
                            <img src="~/Icons/star.png" />
                            <img src="~/Icons/empty-star.png" />
                        </div>

                        <span class="card-price">
                            від @property.PricePerNight@property.Currency за ніч
                        </span>

                    </div>

                </div>
            </a>}

        @for(int i = Model.Hotels.Count; i < 4; i++){
            <div class="card card-empty"></div>
        }

    </div>

    <div class="popular-head">
        <div>
            <h2>Атмосферні апартаменти Риму</h2>
            <p>Апартаменти в самому серці історії</p>
        </div>
        <button class="blue more-popular">Знайти більше помешкань</button>
    </div>

    <div class="cards">
        @foreach(var property in Model.Apartments){
            <a asp-controller="Home" asp-action="Property" asp-route-id="@property.Id"class="card">

                @if(property.Images.Any()){
