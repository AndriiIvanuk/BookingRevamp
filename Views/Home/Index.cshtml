                            <img src="~/Icons/star.png" />
                            <img src="~/Icons/star.png" />
                            <img src="~/Icons/empty-star.png" />
                        </div>

                        <span class="card-price">
                            від @property.PricePerNight@property.Currency за ніч
                        </span>

                    </div>

                </div>
            </a>}

        @for(int i = Model.Villas.Count; i < 4; i++){
            <div class="card card-empty"></div>
        }

    </div>
</section>