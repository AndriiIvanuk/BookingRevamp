@model Property
@{
    ViewData["Title"] = $"Перегляд об'єкту - {Model.Object}";
    ViewData["HideSiteName"] = true;
}

<div class="create-property-page container">

    <div class="photo-section">
        <div class="photo-grid">
            @foreach(var image in Model.Images.Take(8))
            {
                <div class="photo-slot">
                    <img src="@image.ImagePath" />
                </div>
            }
        </div>
    </div>

    <h3>@Model.Object</h3>

    <p>@Model.City @Model.Object</p>

    <div class="rows review">
        <div class="rating">
            <img src="~/Icons/star.png" />
            <img src="~/Icons/star.png" />
            <img src="~/Icons/star.png" />
            <img src="~/Icons/star.png" />
            <img src="~/Icons/empty-star.png" />
        </div>

        <p>@Model.PricePerNight грн за ніч</p>
    </div>

    <h3>Зручності та можливості</h3>
    <p>Вкажи, що включено для комфорту мешканців</p>

    <div class="ameniries">

        @foreach(var propertyAmenity in Model.Amenities){
            <button type="button" class="toggle-btn amenity @propertyAmenity.Amenity.Size" disabled>
                <img src="~/Icons/@propertyAmenity.Amenity.Icon" />
                <span>@propertyAmenity.Amenity.Name</span>
            </button>
        }
        
    </div>

    <h3>Опис від власника</h3>
    <p>Відверто про об’єкт та його переваги</p>

    <p>@Model.Description</p>

    <h3>Важливо знати перед заселенням</h3>
    <p>Ознайомся з основними правилами перед заселенням</p>

    <p>@Model.Rules</p>

    <h3>Місцезнаходження</h3>

    <div class="map">
        <img src="~/Icons/Map.svg" />
    </div>

    <h3>Деталі бронювання</h3>
    <p>Перевір інформацію перед підтвердженням</p>

    <form asp-controller="Home" asp-action="Booking" method="get" class="add-object">
        <input type="hidden" name="propertyId" value="@Model.Id" />

        <input type="hidden" name="propertyId" value="@Model.Id" />

        <div class="search-bottom property-search">
            <div class="search-row date-row">
                <img src="~/Icons/Calendar.png" class="icon calendar-trigger" data-target="checkIn" />
                <input type="date" id="checkIn" name="checkIn" class="custom-date" />
            </div>
            <div class="search-row date-row">
                <img src="~/Icons/Calendar.png" class="icon calendar-trigger" data-target="checkOut" />
                <input type="date" id="checkOut" name="checkOut" class="custom-date" />
            </div>
            <div class="search-row">
                <img src="~/Icons/People.png" class="icon" />
                <input type="number" name="guests" min="1" max="@Model.MaxGuests" value="2" />
            </div>
        </div>

        <button type="submit" class="acid">Забронювати</button>
    </form>

</div>

<script>

    document.addEventListener("DOMContentLoaded", () => {

        const checkIn = document.getElementById("checkIn");

        const checkOut = document.getElementById("checkOut");

        const today = new Date();

        const weekLater = new Date();

        weekLater.setDate(today.getDate() + 7);

        function formatDate(date){
            const year = date.getFullYear();

            const month = String(date.getMonth() + 1).padStart(2, "0");

            const day = String(date.getDate()).padStart(2, "0");

            return `${year}-${month}-${day}`;
        }
        
        function getNextDay(dateString) {
            
            const date = new Date(dateString);
            
            date.setDate(date.getDate() + 1);
            
            return formatDate(date);
        }

        checkIn.value = formatDate(today);

        checkOut.value = formatDate(weekLater);
        
        checkIn.min = formatDate(today);
        
        checkOut.min = getNextDay(checkIn.value);
        
        checkIn.addEventListener("change", () => {
            checkOut.min = checkIn.value;
            
            if (checkOut.value < checkIn.value) {
                checkOut.value = checkIn.value;
            }
        });
        
    });
    
    
    document.querySelectorAll(".calendar-trigger").forEach(icon => {
        
        icon.addEventListener("click", () => {
            
            const input = document.getElementById(icon.dataset.target);
            
            if(input.showPicker){
                input.showPicker();
            } 
            else{
                input.focus();
            }

        });

    });
</script>
