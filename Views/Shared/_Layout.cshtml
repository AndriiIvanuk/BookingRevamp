<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Winbook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header class="topbar">
    <div class="container nav-wrap">
        <a asp-controller="Home" asp-action="Index" class="logo-btn">
            <img src="~/Icons/Winbook.svg" alt="Winbook" class="logo-img" />
        </a>
        @if (User.Identity.IsAuthenticated){
            <nav class="nav-actions">
                    <a class="btn authorized-btn"><img src="~/Icons/Message.png" /></a>
                    <a class="btn authorized-btn"><img src="~/Icons/Heart.png" /></a>
                    <a asp-controller="Authorize" asp-action="Logout" class="btn authorized-btn"><img src="~/Icons/Search.png" /></a>
                <a asp-controller="" asp-action="" class="btn btn-solid">Стати партнером</a>
            </nav>
        }
        else{
            <div class="nav-actions">
                <a asp-controller="Authorize" asp-action="Register" class="btn btn-outline">Зареєструватися</a>
                <a asp-controller="Authorize" asp-action="Login" class="btn btn-solid">Увійти</a>
            </div>
        }
        </div>
</header>
<main>
    @RenderBody()
</main>
    @RenderSection("Scripts", required: false)
</body>
</html>
