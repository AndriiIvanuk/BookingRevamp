<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Winbook</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header class="topbar">
    <div class="container nav-wrap">
        <a asp-controller="Home" asp-action="Index" class="logo-btn">
            <img src="~/Icons/Winbook.svg" alt="Winbook" class="logo-img" />
        </a>
        <div class="nav-actions">
            <a asp-controller="Home" asp-action="Register" class="btn btn-outline">Зареєструватися</a>
            <a asp-controller="Home" asp-action="Login" class="btn btn-solid">Увійти</a>
        </div>
    </div>
</header>
<main>
    @RenderBody()
</main>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
