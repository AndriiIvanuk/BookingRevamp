@{
    ViewData["Title"] = "Додавання об'єкту";
}

@model BookingRevamp.Models.CreatePropertyViewModel

@using BookingRevamp.Models

<body class="create-property-page">
    <form asp-action="CreateProperty" asp-controller="Partner" method="post" enctype="multipart/form-data" class="container">
        <h1>Давай опублікуємо новий об'єкт</h1>

        <h3>Створи перше враження</h3>
        <p>Додай фото, що передають атмосферу та затишок твого простору</p>

        <div class="photo-section">

            <div class="photo-grid">
                <label class="photo-upload">

                    <input asp-for="Images" id="photoInput" type="file" multiple hidden />

                    <div class="upload-content">
                        <img src="~/Icons/Upload.png" class="upload-icon" />
                        <p>
                            Перетягни або
                            <u>обери файл</u>
                        </p>
                    </div>

                </label>
                
                <div class="photo-slot">
                    <img src="~/Icons/photo-placeholder.png">
                </div>

                <div class="photo-slot">
                    <img src="~/Icons/photo-placeholder.png">
                </div>

                <div class="photo-slot">
                    <img src="~/Icons/photo-placeholder.png">
                </div>
            </div>
        </div>

        <div class="rows">
            <label class="gray">Перше фото - обкладинка оголошення</label>

            <label class="gray">Можеш завантажити до восьми фото</label>
        </div>

        <h3>Розкажи про формат житла</h3>
        <p>Правильно обраний тип підвищує довіру та кількість бронювань</p>

        <div class="chips rows">
            <button type="button" class="toggle-btn property-type s" data-value="Будинок">Будинок</button>

            <button type="button" class="toggle-btn property-type s" data-value="Готель">Готелі</button>

            <button type="button" class="toggle-btn property-type m" data-value="Апартаменти">Апартаменти</button>

            <button type="button" class="toggle-btn property-type s" data-value="Вілла">Вілли</button>
        </div>

        <input asp-for="PropertyType" id="propertyType" hidden />

        <h3>Місцезнаходження</h3>
        <p>Ця інформація допоможе гостям бачити об’єкт на карті та оцінити район</p>
        <div class="location">

            <div class="field">
                <input asp-for="Country" placeholder="Введи назву країни" />
            </div>

            <div class="field">
                <input asp-for="City" placeholder="Введи назву міста" />
            </div>

            <div class="field">
                <input asp-for="Address" placeholder="Введи назву вулиці" />
            </div>

            <div class="field">
                <input asp-for="Object" id="Object" placeholder="Введи назву об’єкту" />
            </div>

        </div>

        <div class="map">
            <img src="~/Icons/Map.svg" />
        </div>

        <h3>Максимальна кількість гостей</h3>
        <p>Вкажи, скільки людей можуть комфортно проживати у твоєму житлі</p>

        <div class="guests-row">

            <input asp-for="MaxGuests" id="maxGuests" type="hidden" value="1" />

            <div class="field guest-input">
                <input type="text" value="Скільки гостей ти можеш прийняти?" disabled />
            </div>

            <div class="counter">

                <button type="button" id="minusGuest">
                    −
                </button>
                <span id="guestCount">
                    1
                </span>
                <button type="button" id="plusGuest">
                    +
                </button>
            </div>
        </div>

        <div class="rows-check">
            <label class="check-row">
                <input asp-for="AllowPets" type="checkbox" />
                <span>
                    Дозволено з домашніми тваринами
                </span>
            </label>

            <label class="check-row">
                <input asp-for="AllowChildren" type="checkbox" />
                <span>
                    Дозволено проживання з дітьми
                </span>
            </label>
        </div>

        <h3>Розкажи про свій простір</h3>
        <p>Опиши переваги, атмосферу та все, що може зацікавити гостей</p>

        <textarea asp-for="Description" class="big-field" placeholder="Додай детальну інформацію про об’єкт"></textarea>

        <h3>Зручності та можливості</h3>
        <p>Вкажи, що включено для комфорту мешканців</p>

        <div class="ameniries-div">

            <div id="amenitiesContainer"></div>

            @foreach (var category in Model.Amenities
            .GroupBy(x => x.Category)
            .OrderBy(x => x.Key))
            {
                <p>@category.Key</p>

                <div class="ameniries">

                    @foreach (var amenity in category)
                    {
                        <button type="button" class="toggle-btn amenity @amenity.Size" data-id="@amenity.Id">
                            <img src="~/Icons/@amenity.Icon" />
                            <span>@amenity.Name</span>
                        </button>
                    }
                </div>
            }
        </div>

        <h3>Важливо знати перед заселенням</h3>
        <p>Додай правила, щоб уникнути непорозумінь та забезпечити комфорт</p>

        <textarea asp-for="Rules" class="big-field" placeholder="Основні вимоги до проживання"></textarea>

        <h3>Вартість проживання</h3>
        <p>Конкурентна ціна допоможе швидше отримати бронювання</p>

        <div class="add-object">
            <div class="field">
                <input asp-for="PricePerNight" type="number" step="0.01" min="0" placeholder="Вкажи вартість за ніч" />
            </div>

            <button type="submit" class="acid big" onclick="console.log('Publishing property...')">Опублікувати оголошення</button>
        </div>

    </form>
    <script>
        
        const maxGuestsInput = document.getElementById("maxGuests");
        
        const guestCount = document.getElementById("guestCount");
        
        const minusGuest = document.getElementById("minusGuest");
        
        const plusGuest = document.getElementById("plusGuest");
        
        let guests = 1;
        
        function updateGuests(){
            guestCount.innerText = guests;
            
            maxGuestsInput.value = guests;
        }
        
        plusGuest.addEventListener("click", ()=>
        {
            if(guests < 20){
                guests++;
                updateGuests();
            }
        });
        
        minusGuest.addEventListener("click", ()=>
        {
            if(guests > 1){
                guests--;
                updateGuests();
            }
        });
        
        
        const propertyInput = document.getElementById("propertyType");
        
        document.querySelectorAll(".property-type").forEach(button => {
            
            button.onclick = () => {
                
                document.querySelectorAll(".property-type").forEach(x => x.classList.remove("active"));
                
                button.classList.add("active");
                
                propertyInput.value = button.dataset.value;
            };
        });
        
        
        document.addEventListener("DOMContentLoaded", () => {
            
            const container = document.getElementById("amenitiesContainer");
            
            document.querySelectorAll(".toggle-btn.amenity").forEach(button => {
                
                button.addEventListener("click", () => {
                    
                    button.classList.toggle("active");
                    
                    const id = button.dataset.id;
                    
                    const existing = container.querySelector(
                        `input[value="${id}"]`
                    );
                    
                    if(existing){
                        existing.remove();
                    }
                    else{
                        
                        const input = document.createElement("input");
                        
                        input.type = "hidden";
                        
                        input.name = "SelectedAmenities";
                        
                        input.value = id;
                        
                        container.appendChild(input);
                    
                    }
                    
                });
            });
        });
        
        
        document.addEventListener("DOMContentLoaded", () => {
            
            const input = document.getElementById("photoInput");
            
            const grid = document.querySelector(".photo-grid");
            
            const uploadLabel = document.querySelector(".photo-upload");
            
            const MAX_FILES = 8;
            
            const MAX_SIZE = 10 * 1024 * 1024;
            
            const ALLOWED_EXTENSIONS = [
                "jpg",
                "jpeg",
                "png",
                "webp"
            ];
            
            let selectedFiles = [];
            
            input.addEventListener("change", function(){
                
                const newFiles = Array.from(this.files);
                
                if(selectedFiles.length >= MAX_FILES){
                    alert('Можна завантажити максимум ' + MAX_FILES + ' фото.');
                    
                    this.value = "";

                    return;
                }
                
                for(const file of newFiles){
                    
                    if(selectedFiles.length >= MAX_FILES){
                        
                        break;
                    }
                    
                    const extension = file.name.split(".").pop().toLowerCase();
                    
                    if(!ALLOWED_EXTENSIONS.includes(extension)) {
                        alert(`${file.name}\n\nДозволені лише JPG, JPEG, PNG та WEBP.`);

                        continue;
                    }
                    
                    if(file.size > MAX_SIZE) {
                        alert(`${file.name}\n\nФайл перевищує 10 МБ.`);
                        
                        continue;
                    }
                    
                    selectedFiles.push(file);
                }
                
                updatePreview();
                
                updateInputFiles();
            });
            
            function updatePreview(){
                
                document.querySelectorAll(".photo-slot.dynamic").forEach(x => x.remove());

                document.querySelectorAll(".remove-photo").forEach(x => x.remove());

                const slots = document.querySelectorAll(".photo-slot");

                slots.forEach(slot => {

                    const img = slot.querySelector("img");

                    if(img){
                        img.src = "/Icons/photo-placeholder.png";
                    }
                });

                selectedFiles.forEach((file, index) => {
                    
                    const reader = new FileReader();

                    reader.onload = function (e) {

                        if(index < 3){

                            const img = slots[index].querySelector("img");

                            img.src = e.target.result;

                            const removeButton = document.createElement("button");

                            removeButton.type = "button";
                            removeButton.classList.add("remove-photo");
                            removeButton.dataset.index = index;
                            removeButton.textContent = "×";

                            slots[index].appendChild(removeButton);
                        }
                        else{

                            const slot = document.createElement("div");

                            slot.classList.add(
                                "photo-slot",
                                "dynamic"
                            );

                            const img = document.createElement("img");

                            img.src = e.target.result;

                            slot.appendChild(img);

                            const removeButton = document.createElement("button");

                            removeButton.type = "button";
                            removeButton.classList.add("remove-photo");
                            removeButton.dataset.index = index;
                            removeButton.textContent = "×";
                            
                            slot.appendChild(removeButton);

                            grid.appendChild(slot);
                        }
                    };

                    reader.readAsDataURL(file);
                });

                uploadLabel.style.display = selectedFiles.length >= MAX_FILES ? "none" : "flex";
            }
            
            function updateInputFiles(){
                
                const dataTransfer = new DataTransfer();
                
                selectedFiles.forEach(file => {
                    dataTransfer.items.add(file);
                });
                
                input.files = dataTransfer.files;
            }
            
            document.addEventListener("click", function (e){

                if(!e.target.classList.contains("remove-photo"))
                
                return;
                
                const index = parseInt(e.target.dataset.index);
                
                selectedFiles.splice(index, 1);
                
                updatePreview();
                
                updateInputFiles();
            });
            
            updatePreview();

        });
    </script>
</body>
