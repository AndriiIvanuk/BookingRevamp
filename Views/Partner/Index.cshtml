@{
    ViewData["Title"] = "Сторінка партнера";
}

@model IEnumerable<BookingRevamp.Models.Property>

<section>
    <div class="partner-section">

        <div class="favorites-head">
            <h2>Керування об'єктами</h2>

            <p>Переглядай, редагуй та керуй своїми об'єктами</p>
        </div>

        <div class="partner-properties">

            @foreach(var property in Model)
            {
                <div class="partner-card">

                    <div class="favorite-button delete-property" data-id="@property.Id">
                        <img class="favorite-icon" src="~/Icons/delete-flag.png" />
                    </div>

                    <a asp-controller="Home" asp-action="Property" asp-route-id="@property.Id">

                        <img src="@property.Images.FirstOrDefault()?.ImagePath" class="partner-image" />

                        <h3>@property.Object</h3>

                    </a>

                </div>
            }

            @for(int i = Model.Count(); i < 4; i++)
            {
                <a asp-action="CreateProperty" class="partner-card">

                    <img src="~/Icons/photo-placeholder.png" class="partner-image" />

                    <h3 class="style-underline">Створи нове оголошення</h3>

                </a>
            }

        </div>

    </div>
</section>
<section class="partner-bookings-page">

    <div class="favorites-head">
        <h2>Таблиця бронювань</h2>
        <p>Усі заселені та вільні дати — в одному зручному форматі</p>
    </div>

    @foreach(var property in Model)
    {
        <div class="property-bookings-header-card">

            <div class="property-title">
                <h2>@property.Object</h2>

                <span>@property.City, @property.Address</span>
            </div>

        </div>

        <div class="property-bookings-card">

            @{
                var bookings = property.Bookings
                    .Where(x => x.CheckOut >= DateTime.Today.AddMonths(-6))
                    .OrderByDescending(x => x.CreatedAt)
                    .ToList();
            }

            @if(bookings.Any())
            {
                <div class="booking-table-wrapper">

                    <table class="booking-table">

                        <thead class="booking-table-head">
                            <tr>
                                <th class="column-number">№</th>
                                <th class="column-guest">Гість</th>
                                <th class="column-guests">Гостей</th>
                                <th class="column-date">Заїзд</th>
                                <th class="column-date">Виїзд</th>
                                <th class="column-status">Днів</th>
                                <th class="column-price">Сума</th>
                                <th class="column-payment">Оплата</th>
                                <th class="column-phone">Телефон</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach(var booking in bookings)
                            {
                                <tr class="booking-row">
                                    <td class="booking-number">@booking.BookingNumber</td>
                                    <td class="booking-name">@booking.FullName</td>
                                    <td class="booking-guests">@booking.Guests</td>
                                    <td class="booking-checkin">@booking.CheckIn.ToString("dd.MM.yyyy")</td><td class="booking-checkout">@booking.CheckOut.ToString("dd.MM.yyyy")</td>
                                    <td>@((booking.CheckOut - booking.CheckIn).Days)</td>
                                    <td class="booking-amount">@booking.Amount @booking.Currency</td>
                                    <td class="booking-payment">@booking.PaymentMethod</td>
                                    <td class="booking-phone">@booking.PhoneNumber</td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="no-bookings">
                    Для цього помешкання ще немає бронювань.
                </div>
            }

        </div>
    }

</section>
<script>
    document.querySelectorAll(".delete-property").forEach(button => {

        button.addEventListener("click", async function (e) {

            e.preventDefault();

            e.stopPropagation();

            const confirmed = confirm("Ви точно хочете видалити цей об'єкт?");

            if (!confirmed)
                return;

            const id = this.dataset.id;

            const response = await fetch("/Partner/DeleteProperty", {

                method: "POST",

                headers: {
                    "Content-Type": "application/x-www-form-urlencoded"
                },

                body: `id=${id}`

            });

            if(!response.ok)
            {
                alert("Не вдалося видалити об'єкт.");

                return;
            }

            this.closest(".partner-card").remove();

            window.location.reload();

        });

    });
</script>